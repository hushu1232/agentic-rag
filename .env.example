# 模型与向量：OpenAI 兼容接口。三项必填。
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus

# 生成 embedding 的模型名（维度由接口返回决定，不在此配置）
EMBEDDING_MODEL=text-embedding-v3

# 可选：判官单独用更强的模型（留空则与 MODEL_NAME 相同）
JUDGE_MODEL=

# 可选：rerank 关闭时不需要填。开启时 config.yaml 里 rerank.enabled 需同时为 true
RERANK_API_KEY=
